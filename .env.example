# Application
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://bhavaninfo:bhavaninfo@localhost:5432/bhavaninfo

# Frontend
VITE_API_URL=http://localhost:4000

# Authentication
SESSION_SECRET=replace-me

# UIDAI Authentication
# uidai-test-fixture = official UIDAI-published test data, local deterministic demo
# uidai-sandbox = actual UIDAI sandbox adapter; requires authorized credentials/certificates
AADHAAR_AUTH_PROVIDER=uidai-test-fixture
UIDAI_ENVIRONMENT=sandbox
UIDAI_AUA_CODE=
UIDAI_SUB_AUA_CODE=
UIDAI_LICENSE_KEY=
UIDAI_API_URL=
UIDAI_AUTH_URL=
UIDAI_CERTIFICATE_PATH=
UIDAI_SIGNATURE_KEY_PATH=

# Spatial
DEFAULT_CRS=EPSG:4326

# External data providers
OSM_ENABLED=true
